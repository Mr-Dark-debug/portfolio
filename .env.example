NEXT_PUBLIC_SITE_URL=https://prashant.sbs

# Studio authentication. Generate the hash with: npm run hash-password
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Git-backed Markdown CMS. Use a fine-grained token with Contents: read/write.
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_OWNER=
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_BRANCH=main

# Media. Vercel Blob is preferred when configured; otherwise local/Git storage is used.
BLOB_READ_WRITE_TOKEN=

# Optional AI provider for TL;DR, SEO suggestions, internal-link assistance, and repurposing.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_API_URL=

# Existing Groq integration and public repository reader.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GITHUB_READ_TOKEN=

# Vercel Web Analytics API. Values remain server-only.
VERCEL_ANALYTICS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
AI_CRAWLER_POLICY=allow

# Existing services.
DATABASE_URL=
FORMSPREE_FORM_ID=mwvyznvj
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
SENTRY_DSN=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional social metadata providers. Manual cards work without these.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
X_BEARER_TOKEN=
X_USER_ID=
FACEBOOK_ACCESS_TOKEN=
